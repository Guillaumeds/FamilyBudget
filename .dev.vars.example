# Local secrets for `wrangler dev` and tests. Copy to `.dev.vars` (git-ignored) and fill in.
# In production set each one with `wrangler secret put <NAME>` (or `npm run setup`).
# Only WALLET_API_TOKEN, DASHBOARD_PASSWORD and SESSION_SECRET are needed for the dashboard + sync;
# WhatsApp and Claude features switch on only when their secrets (and settings flags) are present.

# BudgetBakers Wallet REST API token (Wallet web app -> Settings -> REST API; Premium plan required).
WALLET_API_TOKEN=

# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup).
# Permanent System User access token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Phone number ID of the sending business number (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value into the Meta webhook "Verify token" field.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret (App settings -> Basic); used to verify the X-Hub-Signature-256 webhook header.
META_APP_SECRET=

# Anthropic API key for the optional Claude Q&A over WhatsApp.
ANTHROPIC_API_KEY=

# Password for the web dashboard login form.
DASHBOARD_PASSWORD=
# Random string (32+ bytes) used to sign dashboard session cookies, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
