/**
 * Wrangler configuration — https://developers.cloudflare.com/workers/wrangler/configuration/
 * After changing bindings or vars, regenerate types with `npm run cf-typegen`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wallet-budget-companion",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	"observability": {
		"enabled": true,
	},

	// One hourly UTC cron. Everything local-time based (daily brief, cash-flow capture, weekly full
	// re-sync) is dispatched in code from the `timezone` setting, which keeps it DST-safe.
	"triggers": {
		"crons": ["0 * * * *"],
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wallet-budget-companion",
			// Replaced by `npm run setup` (or paste the id printed by `wrangler d1 create wallet-budget-companion`).
			"database_id": "82f80059-73d3-44ab-9457-0280cbdb1e6f",
			"migrations_dir": "migrations",
		},
	],

	// Dashboard static files. The Worker only runs first for the API and the WhatsApp webhook;
	// every other path is served straight from ./public.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/webhook*"],
	},

	// Non-secret configuration. Secrets live in `.dev.vars` locally (see `.dev.vars.example`) and are
	// set in production with `wrangler secret put <NAME>`.
	"vars": {
		"WALLET_API_BASE_URL": "https://rest.budgetbakers.com/wallet",
		"WHATSAPP_API_VERSION": "v26.0",
		// Cloudflare Turnstile site key for the signup page (public). Empty = no CAPTCHA widget.
		"TURNSTILE_SITE_KEY": "",
	},

	// ------------------------------------------------------------------------------------------
	// Per-household task queue. Queues have a Free-plan allowance (10k operations/day — roughly
	// 3 per message, so ~72/day per household); the Paid plan lifts limits and retention. The
	// binding only deploys once the queues EXIST, hence commented by default. While this block
	// stays commented out, env.HOUSEHOLD_TASKS is undefined and the hourly cron runs every
	// household's tasks inline (src/scheduled.ts), which is fine for a handful of households.
	// To enable (https://developers.cloudflare.com/queues/get-started/):
	//   1. npx wrangler queues create household-tasks
	//   2. npx wrangler queues create household-tasks-dlq
	//   3. uncomment the block below, then redeploy (npm run deploy).
	// ------------------------------------------------------------------------------------------
	// "queues": {
	// 	"producers": [{ "binding": "HOUSEHOLD_TASKS", "queue": "household-tasks" }],
	// 	"consumers": [
	// 		{
	// 			"queue": "household-tasks",
	// 			"max_batch_size": 5,
	// 			"max_batch_timeout": 5,
	// 			"max_retries": 3,
	// 			"max_concurrency": 4,
	// 			"dead_letter_queue": "household-tasks-dlq",
	// 		},
	// 		// Dead letters are logged to run_log (ERROR) and acked — see queueHandler in src/tasks.ts.
	// 		{ "queue": "household-tasks-dlq" },
	// 	],
	// },
}
